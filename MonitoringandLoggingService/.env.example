# Copy to .env and set values accordingly
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# JWT verification (RS256)
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PUBLIC_KEY\n-----END PUBLIC KEY-----
JWT_ALG=RS256

# For agents/services that cannot use JWT, API keys for ingestion (comma-separated)
INGEST_API_KEYS=key1,key2

# External SIEM/ELK forwarding
ELK_ENABLED=false
LOGSTASH_HTTP_URL=
ELASTIC_URL=
ELK_INDEX_PREFIX=mls

# Pagination and retention
PAGE_SIZE=20
RETENTION_DAYS=30

# Compliance officer notifications (future use)
COMPLIANCE_OFFICER_EMAIL=
REQUEST_LOGGING=true
