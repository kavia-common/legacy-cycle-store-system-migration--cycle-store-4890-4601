# Server
PORT=3004
HOST=0.0.0.0
NODE_ENV=development
SERVICE_NAME=MonitoringandLoggingService

# Correlation ID header name (lowercase recommended)
CORRELATION_ID_HEADER=x-correlation-id

# Persistence
PERSIST_TO_FILE=false
DATA_DIR=./data

# External integrations (documented, not required for local demo)
ELASTIC_URL=
PROMETHEUS_PUSHGATEWAY_URL=

# NotificationService integration
NOTIFICATION_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_TOKEN=
